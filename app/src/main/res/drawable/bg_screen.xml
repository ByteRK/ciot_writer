<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏背景：深邃靛蓝底色 + 顶部柔和的径向蓝色光晕 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/colorBackground" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerColor="#1A4F9CF9"
                android:centerX="0.5"
                android:centerY="0.0"
                android:endColor="#000F172A"
                android:gradientRadius="560dp"
                android:startColor="#4D4F9CF9"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
