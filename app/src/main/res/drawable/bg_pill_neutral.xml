<?xml version="1.0" encoding="utf-8"?>
<!-- 中性胶囊：极淡蓝色光晕 + 半透明玻璃底 + 1px 描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/colorPrimaryHalo" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="25dp" />
            <solid android:color="@color/colorNeutralFill" />
            <stroke
                android:width="1dp"
                android:color="@color/colorNeutralBorder" />
        </shape>
    </item>
</layer-list>
