<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/field_name"
            android:textColor="@color/colorMuted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/fieldName"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/field_pid"
            android:textColor="@color/colorMuted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/fieldPid"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/field_nic"
            android:textColor="@color/colorMuted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/fieldNic"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/field_path"
            android:textColor="@color/colorMuted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/fieldPath"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/field_port"
            android:textColor="@color/colorMuted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/fieldPort"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/field_username"
            android:textColor="@color/colorMuted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/fieldUsername"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/field_password"
            android:textColor="@color/colorMuted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/fieldPassword"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="@string/field_content"
            android:textColor="@color/colorMuted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/fieldContent"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="5" />
    </LinearLayout>
</ScrollView>
