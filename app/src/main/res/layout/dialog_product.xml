<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <TextView
            style="@style/CIOT.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/field_name" />

        <EditText
            android:id="@+id/fieldName"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            style="@style/CIOT.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_pid" />

        <EditText
            android:id="@+id/fieldPid"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            style="@style/CIOT.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_nic" />

        <EditText
            android:id="@+id/fieldNic"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            style="@style/CIOT.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_path" />

        <EditText
            android:id="@+id/fieldPath"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            style="@style/CIOT.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_port" />

        <EditText
            android:id="@+id/fieldPort"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="number"
            android:singleLine="true" />

        <TextView
            style="@style/CIOT.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_username" />

        <EditText
            android:id="@+id/fieldUsername"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            style="@style/CIOT.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_password" />

        <EditText
            android:id="@+id/fieldPassword"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            style="@style/CIOT.FieldLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/field_content" />

        <EditText
            android:id="@+id/fieldContent"
            style="@style/CIOT.EditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:minLines="5" />
    </LinearLayout>
</ScrollView>
